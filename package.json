    "@mapbox/hash-key": "^1.1.0",
    "@mapbox/mapbox-cdk-common": "^7.2.0",
    "@mapbox/mapbox-error": "^3.0.1",
    "@mapbox/polyline": "^1.1.0",
    "@mapbox/post-to-slack": "^1.3.0",
    "@mapbox/ratelimit": "^4.0.0",
    "@mapbox/s3-bucket-template": "^2.0.8",
    "@mapbox/search-tag-to-brand": "^2.6.2",
    "@mapbox/tag-to-category": "^6.2.12",
