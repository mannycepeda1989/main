  "scripts": {
    "start": "node server.js",
    "json-lint": "find . -not -path './node_modules/*' -not -path '*/fixtures/*' -name '*.json' -exec echo {} \\; -exec jsonlint {} --quiet \\;",
    "lint": "eslint --fix *.js 'test/**/*.js' 'lib/**/*.js' 'indexer/**/*.js' 'scripts/**/*.js' 'utils/**/*.js' 'cloudformation/**.js' 'autoscaling/**/*.js' 'cluster_proxy/**/*.js'",
    "devserver": "node test/scripts/devserver.js",
    "json-format": "prettier --write 'test/unit/fixtures/**/*.json'",
    "json-format-check": "prettier --check 'test/unit/fixtures/**/*.json'",
    "test": "npm run lint && npm run json-format-check && npm run json-lint && npm run unit-test",
    "coverage": "nyc report --reporter html && opener coverage/index.html",
    "unit-test": "nyc tape test/unit/*.test.js  test/unit/middleware/*.test.js --coverage --check-coverage true",
    "integration-test": "node test/scripts/run-integration-tests.js",
    "integration-test-dev": "nyc tape test/integration/*.test.js test/integration/**/*.test.js --coverage",
    "quality-test": "node test/scripts/run-quality-tests.js",
    "recall-test": "node test/scripts/run-recall-tests.js",
    "cluster-proxy": "node cluster_proxy/index.js",
    "regression-test": "tape test/regression/regression.test.js",
    "restore-snapshot-to-cluster": "node test/scripts/restore-snapshot-to-cluster.js",
    "cdk": "cdk"
  },
  "name": "api-poi-search",
  "description": "Dedicated POI Search API",
  "version": "1.2.0",
  "main": "server.js",
  "directories": {
    "lib": "lib"
  },
  "eslintConfig": {
    "extends": [
      "@mapbox/eslint-config-mapbox",
      "@mapbox/eslint-config-mapbox/promise"
    ],
    "parserOptions": {
      "ecmaVersion": 2020
    },
    "plugins": [
      "json"
    ],
    "rules": {
      "space-before-blocks": [
        "error",
        "always"
      ],
      "arrow-spacing": [
        "error"
      ],
      "no-prototype-builtins": "off"
    }
  },
  "devDependencies": {
    "@mapbox/api-poi-search-quality-test": "2.1.5",
    "@mapbox/eslint-config-mapbox": "^2.0.1",
    "@mapbox/mbxcli": "^6.3.8",
    "@mapbox/mock-aws-sdk-js": "^1.0.0",
    "@mapbox/secret-cloudfriend": "^7.1.0",
    "@prantlf/jsonlint": "16.0.0",
    "aws-cdk": "^2.130.0",
    "aws-es-kibana": "^1.0.8",
    "commander": "^7.2.0",
    "dynalite": "^3.1.5",
    "eslint": "^6.8.0",
    "eslint-plugin-json": "^2.0.1",
    "eslint-plugin-node": "^10.0.0",
    "eslint-plugin-promise": "^4.2.1",
    "minimist": "^1.2.5",
    "mock-req": "^0.2.0",
    "mock-res": "^0.5.0",
    "node-mocks-http": "^1.8.1",
    "nyc": "^14.1.1",
    "opener": "^1.5.1",
    "portfinder": "^1.0.25",
    "prettier": "^3.0.0",
    "sinon": "^7.5.0",
    "sinon-express-mock": "^2.2.1",
    "tape": "^4.11.0",
    "tape-await": "^0.1.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mapbox/api-poi-search.git"
  },
  "author": "Mapbox",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/mapbox/api-poi-search/issues"
  },
  "homepage": "https://github.com/mapbox/api-poi-search#readme",
  "engines": {
    "node": ">=18.16.0"
  },
  "nyc": {
    "all": true,
    "statements": 62,
    "branches": 59,
    "functions": 62,
    "lines": 62,
    "exclude": [
      "test/**",
      "coverage/**",
      "cloudformation/**",
      "demo/**",
      "scripts/**",
      "bin/**"
    ]
  }
}
