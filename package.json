    "console.table": "^0.10.0",
    "cors": "^2.8.5",
    "csv-parser": "^3.0.0",
    "elastic-builder": "^2.6.0",
    "express": "^4.21.2",
    "got": "^11.8.5",
    "handlebars": "^4.7.7",
    "http-aws-es": "^6.0.0",
